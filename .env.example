# Browser used by get_cookies.py: edge, chrome, or yandex.
OZON_BROWSER=edge
# Optional overrides if the browser is installed in a non-standard location.
# OZON_EDGE_BINARY=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# OZON_CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
# OZON_YANDEX_BINARY=C:\Program Files\Yandex\YandexBrowser\Application\browser.exe
# Optional VPN-safe local fallback; data/ is ignored by Git.
# OZON_CHROMEDRIVER_PATH=E:\AI_Projects\TZ_YourFit\data\webdriver\chromedriver.exe

# Local paths. Cookies and debug HTML are intentionally ignored by Git.
OZON_COOKIES_PATH=data/cookies.json
OZON_OUTPUT_PATH=output/products.csv
OZON_ERRORS_PATH=output/errors.csv
OZON_DEBUG_DIR=debug

# Network behavior for parse_ozon.py.
OZON_REQUEST_TIMEOUT=30
OZON_MAX_RETRIES=3
OZON_RETRY_BACKOFF=1.0
OZON_REQUEST_DELAY=1.5
